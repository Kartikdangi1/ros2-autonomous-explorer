<!--
  Exploration Behavior Tree — autonomous_explorer

  Two-level recovery pattern (Nav2 Humble recommended):

  Level 1 — Contextual recovery (within the navigation pipeline):
    - ComputePathToPose failure → clear global costmap, retry once
    - FollowPath failure → clear local costmap, retry once
    - GoalUpdated check around FollowPath: if NBV sends a new goal mid-recovery,
      the Inverter+GoalUpdated preempts the stale recovery immediately

  Level 2 — System-level recovery (outer RecoveryNode, max 3 retries):
    1. Clear both costmaps (stale inflation data)
    2. Spin 90° — breaks stuck orientations (e.g. robot wedged sideways to wall)
       Fallback to Wait if Spin is blocked
    3. Wait 1 s for costmap to refresh
    4. BackUp 0.3 m — fallback to Wait if "Collision Ahead" blocks it
    5. Wait 1 s
    6. BackUp 0.5 m — fallback to Wait
    7. Wait 2 s before retry

  The Spin node is the key addition: pure backup cannot escape a robot that is
  stuck perpendicular to its travel direction. Spin first, then backup.
-->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">

    <RecoveryNode number_of_retries="3" name="NavigateRecovery">

      <!-- Normal navigation pipeline: plan then follow, replanning at 0.5 Hz (every 2 s) -->
      <PipelineSequence name="NavigateWithReplanning">

        <RateController hz="1.0">
          <RecoveryNode number_of_retries="1" name="ComputePathToPose">
            <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"
                               error_code_id="{compute_path_error_code}"/>
            <ClearEntireCostmap name="ClearGlobalCostmap-Context"
                                service_name="global_costmap/clear_entirely_global_costmap"/>
          </RecoveryNode>
        </RateController>

        <!-- GoalUpdated preemption: if NBV sends a new goal while following,
             the Inverter returns FAILURE → Fallback short-circuits to SUCCESS,
             allowing the outer RateController to pick up the new goal immediately. -->
        <RecoveryNode number_of_retries="1" name="FollowPath">
          <Sequence name="FollowWithGoalCheck">
            <Inverter>
              <GoalUpdated/>
            </Inverter>
            <FollowPath path="{path}" controller_id="FollowPath"
                        error_code_id="{follow_path_error_code}"/>
          </Sequence>
          <ClearEntireCostmap name="ClearLocalCostmap-Context"
                              service_name="local_costmap/clear_entirely_local_costmap"/>
        </RecoveryNode>

      </PipelineSequence>

      <Sequence name="RecoveryActions">

        <!-- Step 1: clear stale costmap inflation data -->
        <ClearEntireCostmap name="ClearLocalCostmap-System"
                            service_name="local_costmap/clear_entirely_local_costmap"/>
        <ClearEntireCostmap name="ClearGlobalCostmap-System"
                            service_name="global_costmap/clear_entirely_global_costmap"/>

        <!-- Step 2: spin to break stuck orientation — Fallback to Wait if blocked -->
        <Fallback>
          <Spin spin_dist="1.57" time_allowance="10"
                error_code_id="{spin_error_code}"/>
          <Wait wait_duration="2"/>
        </Fallback>

        <!-- Step 3: pause for costmap to refresh -->
        <Wait wait_duration="1"/>

        <!-- Step 4: first reverse — capped at 5 s so recovery doesn't stall for 27 s -->
        <Fallback>
          <BackUp backup_dist="0.3" backup_speed="0.15" time_allowance="5"
                  error_code_id="{backup_error_code}"/>
          <Wait wait_duration="2"/>
        </Fallback>

        <!-- Step 5: pause then longer backup before retry -->
        <Wait wait_duration="1"/>
        <Fallback>
          <BackUp backup_dist="0.5" backup_speed="0.15" time_allowance="5"
                  error_code_id="{backup_error_code}"/>
          <Wait wait_duration="3"/>
        </Fallback>

        <!-- Step 6: drive forward — escapes robot backed hard into rear wall -->
        <Wait wait_duration="1"/>
        <Fallback>
          <DriveOnHeading dist_to_travel="0.3" speed="0.15" time_allowance="5"
                          error_code_id="{drive_on_heading_error_code}"/>
          <Wait wait_duration="2"/>
        </Fallback>
        <Wait wait_duration="2"/>

      </Sequence>

    </RecoveryNode>

  </BehaviorTree>
</root>
